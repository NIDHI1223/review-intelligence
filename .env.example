# Copy to .env and fill in. The pipeline degrades gracefully: missing keys
# disable the corresponding source/stage and are recorded in the limitations report.

# Required for enrichment / insight / validation stages
ANTHROPIC_API_KEY=

# Reddit collection (script app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:review-intelligence:v0.1 (research)

# YouTube comment collection (Google Cloud > YouTube Data API v3)
YOUTUBE_API_KEY=
